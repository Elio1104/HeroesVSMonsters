<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>

<VBox xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" alignment="CENTER" spacing="10" fx:controller="technofutur.heroesvsmonsters.menu.gameMenu.GamepadController">
    <HBox alignment="CENTER">
        <Button text="↑" onAction="#movePlayerUp" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-size: 20px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #FFD700; -fx-border-width: 2px;" />
    </HBox>
    <HBox alignment="CENTER" spacing="10">
        <Button text="←" onAction="#movePlayerLeft" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-size: 20px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #FFD700; -fx-border-width: 2px;" />
        <Button text="↓" onAction="#movePlayerDown" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-size: 20px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #FFD700; -fx-border-width: 2px;" />
        <Button text="→" onAction="#movePlayerRight" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-size: 20px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #FFD700; -fx-border-width: 2px;" />
    </HBox>
    <HBox alignment="CENTER">
        <Button text="Attack" onAction="#attack" style="-fx-background-color: #4A5568; -fx-text-fill: white; -fx-font-size: 20px; -fx-padding: 10px; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-border-color: #FFD700; -fx-border-width: 2px;" />
    </HBox>
</VBox>