<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.HBox?>
<?import javafx.geometry.Rectangle2D?>

<StackPane xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="technofutur.heroesvsmonsters.menu.MenuController">

    <!-- Image de fond -->
    <ImageView fitWidth="1200" fitHeight="1000" preserveRatio="false">
        <Image url="@fantasyBackground.jpg" />
    </ImageView>

    <!-- Contenu principal -->
    <VBox alignment="CENTER" spacing="20">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30" />
        </padding>

        <!-- Cadre pour le texte -->
        <VBox alignment="CENTER" spacing="10" style="-fx-background-color: rgba(0, 0, 0, 0.5); -fx-background-radius: 10; -fx-padding: 20;">
            <Text text="Welcome to the forest of 'Shorewood', the enchanted forest of the land of 'Stormwall'"
                  style="-fx-font-size: 24px; -fx-fill: #00FF00; -fx-text-alignment: center; -fx-stroke: black; -fx-stroke-width: 0.5px; -fx-font-weight: bold;"
                  wrappingWidth="700"/>

            <Text text="Choose a race"
                  style="-fx-font-size: 20px; -fx-fill: #FFD700; -fx-stroke: black; -fx-stroke-width: 0.5px; -fx-font-weight: bold;">
                <VBox.margin>
                    <Insets top="20" right="0" bottom="20" left="0" />
                </VBox.margin>
            </Text>
        </VBox>

        <HBox alignment="CENTER" spacing="20">
            <VBox alignment="CENTER" spacing="10">
                <ImageView fitWidth="200" fitHeight="200" preserveRatio="true">
                    <Image url="@Human.png"/>
                    <viewport>
                        <Rectangle2D minX="155" minY="0" width="85" height="128"/>
                    </viewport>
                </ImageView>
                <Button text="Human" onAction="#handleHumanButton" style="-fx-background-color: #4A5568; -fx-text-fill: white;"/>
            </VBox>

            <VBox alignment="CENTER" spacing="10">
                <ImageView fitWidth="200" fitHeight="200" preserveRatio="true">
                    <Image url="@Dwarf.png"/>
                    <viewport>
                        <Rectangle2D minX="150" minY="0" width="85" height="128"/>
                    </viewport>
                </ImageView>
                <Button text="Dwarf" onAction="#handleDwarfButton" style="-fx-background-color: #4A5568; -fx-text-fill: white;"/>
            </VBox>
        </HBox>
    </VBox>

</StackPane>