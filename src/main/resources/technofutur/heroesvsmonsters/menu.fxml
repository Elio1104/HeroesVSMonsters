<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.text.Text?>

<StackPane xmlns="http://javafx.com/javafx/17.0.6" xmlns:fx="http://javafx.com/fxml/1" fx:controller="technofutur.heroesvsmonsters.menu.MenuController">
    <ImageView>
        <Image url="@technofutur/heroesvsmonsters/fantasy_background.png" />
    </ImageView>
    <VBox spacing="10" alignment="CENTER">
        <Text text="Welcome to the forest of Shorewood, the enchanted forest of the land of Stormwall" style="-fx-font-size: 20px; -fx-fill: #FFD700;"/>
        <Text text="Choose a race" style="-fx-font-size: 16px; -fx-fill: #FFD700;"/>
        <Button text="Human" onAction="#handleHumanButton"/>
        <Button text="Dwarf" onAction="#handleDwarfButton"/>
    </VBox>
</StackPane>